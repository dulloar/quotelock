# =============================================================================
# .npmrc - Bridge Node Hardened Configuration
# Protección contra ataques supply chain (Shai-Hulud, Axios, etc.)
# Fecha: Mayo 2026
# =============================================================================

# --- LIFECYCLE SCRIPTS ---
# Deshabilita scripts de instalación (preinstall, postinstall, prepare)
# para TODOS los paquetes de terceros. Esta es la defensa principal contra
# Shai-Hulud y ataques similares que usan hooks de instalación como vector.
ignore-scripts=true

# --- LOCKFILE ESTRICTO ---
# Fuerza que npm use exactamente lo que dice el lockfile.
# Equivalente a usar `npm ci` siempre. Falla si package.json y lockfile divergen.
package-lock=true

# --- AUDITORÍA AUTOMÁTICA ---
# Ejecuta npm audit en cada install. Bloquea si hay vulnerabilidades críticas.
audit=true
audit-level=high

# --- REGISTRO Y RESOLUCIÓN ---
# Registry oficial únicamente. Evita resoluciones a registries no autorizados.
registry=https://registry.npmjs.org/

# --- PROVENANCE ---
# Exige que los paquetes tengan attestation de provenance verificable.
# NOTA: Esto puede romper paquetes legítimos que aún no publican con --provenance.
# Habilitar gradualmente. Descomentar cuando tu stack lo soporte:
# prefer-provenance=true

# --- FUND Y NOTIFICACIONES ---
# Reduce ruido en CI/CD
fund=false
update-notifier=false

# --- SAVE EXACT ---
# Guarda dependencias con versión exacta, sin ^ ni ~
# Previene que rangos flotantes resuelvan a versiones comprometidas.
save-exact=true

# --- ENGINE STRICT ---
# Falla si las dependencias no son compatibles con tu versión de Node.
engine-strict=true

# --- TIMING ---
# Log de timing para auditoría de builds lentos o sospechosos en CI.
timing=true

# =============================================================================
# NOTAS DE USO:
#
# 1. Con ignore-scripts=true, algunos paquetes legítimos necesitan un paso
#    manual post-install. Para ejecutar scripts de un paquete específico:
#      npm rebuild <paquete>
#    O usa un allowlist explícito en cada proyecto.
#
# 2. Para CI/CD, usa SIEMPRE:
#      npm ci --ignore-scripts
#    Nunca `npm install` en pipelines.
#
# 3. Si migras a pnpm (recomendado), pnpm deshabilita scripts por defecto
#    y requiere allowlist explícito. Este .npmrc sigue siendo compatible.
#
# 4. Lifecycle scripts que SÍ necesites correr, agrégalos al package.json
#    del proyecto con un script explícito:
#      "scripts": { "postinstall:safe": "npm rebuild sharp && npm rebuild bcrypt" }
#
# =============================================================================
